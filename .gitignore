# Build output
/bin/

# Nimbus state and certificates (never commit a CA key)
/.nimbus/

# Terraform working files. The lock file IS committed, on purpose: it pins the
# azurerm version the examples were proven against.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
tf.log

# Python harness virtualenvs (test/storage-sdk/run.sh creates one)
.venv/
__pycache__/

# macOS
.DS_Store
kubeconfig
*-kubeconfig
