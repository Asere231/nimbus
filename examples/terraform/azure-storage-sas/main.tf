# A Shared Access Signature that actually decides.
#
#   1. ./bin/nimbus start      (in another terminal)
#   2. terraform apply         and watch http://localhost:4700
#   3. use the tokens below    (see the commands in the outputs)
#   4. terraform destroy
#
# A SAS is how Azure delegates storage access without handing over the account
# key, and it is the one storage credential that carries its own authorization:
# sp says what may be done, se until when, sr what it reaches, and sig is a
# signature over all of it computed with a key Nimbus itself issued. So unlike
# Shared Key -- which carries no identity at all -- Nimbus can answer the
# question a SAS exists to ask: WOULD these permissions work?
#
# Everything here is enforced, and not behind --enforce-iam. A SAS needs no
# principal, so there is no "unmapped caller is unrestricted" fallback for it
# to land in, and real Azure has no mode in which a SAS does not decide.
#
# Four things this example is for, each with a token that demonstrates it:
#
#   read_only_sas   reads a blob and CANNOT write one
#   expired_sas     is refused, and the refusal says when it expired
#   account_sas     is scoped by ss (services) and srt (resource types)
#   public/private  anonymous access, which the CONTAINER decides
#
# Both tokens are generated by the PROVIDER, client-side, from the account key
# -- which is the point. Nothing here tells Nimbus what the token says; Nimbus
# works it out from the signature, exactly as Azure does.

terraform {
  required_version = ">= 1.5"
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
  }
}

provider "azurerm" {
  features {}

  metadata_host   = "localhost:4701"
  subscription_id = "00000000-0000-0000-0000-000000000000"
  tenant_id       = "00000000-0000-0000-0000-000000000001"
  client_id       = "00000000-0000-0000-0000-000000000002"
  client_secret   = "nimbus"

  resource_provider_registrations = "none"
  storage_use_azuread             = false
}

variable "location" {
  type    = string
  default = "eastus"
}

resource "azurerm_resource_group" "sas" {
  name     = "rg-storage-sas"
  location = var.location
}

resource "azurerm_storage_account" "data" {
  name                     = "stnimbussas"
  resource_group_name      = azurerm_resource_group.sas.name
  location                 = azurerm_resource_group.sas.location
  account_tier             = "Standard"
  account_replication_type = "LRS"
}

# Private: reachable only with a credential. An anonymous request here is
# answered 404, not 403 -- Azure will not tell an unauthenticated caller that a
# container it cannot reach exists, because the difference between "private"
# and "absent" is enough to enumerate container names.
resource "azurerm_storage_container" "private" {
  name                  = "private"
  storage_account_id    = azurerm_storage_account.data.id
  container_access_type = "private"
}

# Public at BLOB level: anyone who knows a blob's name may read it, and nobody
# may list the names. That distinction is the whole reason there are two public
# levels -- "container" is the one that also permits a listing.
resource "azurerm_storage_container" "public" {
  name                  = "public"
  storage_account_id    = azurerm_storage_account.data.id
  container_access_type = "blob"
}

resource "azurerm_storage_blob" "secret" {
  name                   = "secret.txt"
  storage_account_name   = azurerm_storage_account.data.name
  storage_container_name = azurerm_storage_container.private.name
  type                   = "Block"
  source_content         = "this blob needs a credential\n"
}

resource "azurerm_storage_blob" "notice" {
  name                   = "notice.txt"
  storage_account_name   = azurerm_storage_account.data.name
  storage_container_name = azurerm_storage_container.public.name
  type                   = "Block"
  source_content         = "anyone may read this one\n"
}

# --- the tokens -------------------------------------------------------------

# A SERVICE SAS scoped to one container (sr=c), read and list only. It reaches
# every blob inside that container and nothing outside it -- enforced by the
# signature itself, since the container name is part of what was signed, so no
# amount of permission juggling can widen it.
data "azurerm_storage_account_blob_container_sas" "read_only" {
  connection_string = azurerm_storage_account.data.primary_connection_string
  container_name    = azurerm_storage_container.private.name
  https_only        = true

  start  = "2024-01-01T00:00:00Z"
  expiry = "2099-01-01T00:00:00Z"

  permissions {
    read   = true
    list   = true
    add    = false
    create = false
    write  = false
    delete = false
  }
}

# The same thing with an expiry in the past. Nimbus refuses it and says WHEN it
# expired, because "403" on its own sends people to look at their permissions,
# which is the one thing that is not wrong.
data "azurerm_storage_account_blob_container_sas" "expired" {
  connection_string = azurerm_storage_account.data.primary_connection_string
  container_name    = azurerm_storage_container.private.name
  https_only        = true

  start  = "2019-01-01T00:00:00Z"
  expiry = "2020-01-01T00:00:00Z"

  permissions {
    read   = true
    list   = true
    add    = false
    create = false
    write  = false
    delete = false
  }
}

# The same token bound to a source IP that is NOT the caller. `sip` is
# IPv4-only at the client -- `az --ip ::1` is rejected by az itself -- and the
# two data sources spell the argument differently: `ip_address` here, and
# `ip_addresses` on the account SAS below.
#
# Only the NEGATIVE case is demonstrated, on purpose. A token scoped to
# 127.0.0.1 passes or fails depending on whether the client resolved the
# data-plane name to 127.0.0.1 or ::1, and Nimbus's nested *.localhost names
# commonly give ::1 -- see docs/IAM.md. A token naming somebody else is
# refused either way, and it is the half that proves enforcement.
data "azurerm_storage_account_blob_container_sas" "wrong_ip" {
  connection_string = azurerm_storage_account.data.primary_connection_string
  container_name    = azurerm_storage_container.private.name
  https_only        = true
  ip_address        = "203.0.113.7"

  start  = "2024-01-01T00:00:00Z"
  expiry = "2099-01-01T00:00:00Z"

  permissions {
    read   = true
    list   = true
    add    = false
    create = false
    write  = false
    delete = false
  }
}

# An ACCOUNT SAS signs a different string of a different length, and is scoped
# by ss (which services) and srt (service, container or object level) rather
# than by a resource. This one covers the blob service at every level.
data "azurerm_storage_account_sas" "blob_rw" {
  connection_string = azurerm_storage_account.data.primary_connection_string
  https_only        = true

  resource_types {
    service   = true
    container = true
    object    = true
  }

  services {
    blob  = true
    queue = false
    table = false
    file  = false
  }

  start  = "2024-01-01T00:00:00Z"
  expiry = "2099-01-01T00:00:00Z"

  permissions {
    read    = true
    write   = true
    list    = true
    add     = true
    create  = true
    delete  = true
    update  = false
    process = false
    tag     = false
    filter  = false
  }
}

# An account SAS for the QUEUE service only. Used against a blob it is refused
# with AuthorizationServiceMismatch: the signature is perfectly good, and ss
# does not name the service being asked for.
data "azurerm_storage_account_sas" "queue_only" {
  connection_string = azurerm_storage_account.data.primary_connection_string
  https_only        = true

  resource_types {
    service   = true
    container = true
    object    = true
  }

  services {
    blob  = false
    queue = true
    table = false
    file  = false
  }

  start  = "2024-01-01T00:00:00Z"
  expiry = "2099-01-01T00:00:00Z"

  permissions {
    read    = true
    write   = true
    list    = true
    add     = true
    create  = true
    delete  = true
    update  = false
    process = false
    tag     = false
    filter  = false
  }
}

# --- outputs ----------------------------------------------------------------

output "blob_endpoint" {
  value = azurerm_storage_account.data.primary_blob_endpoint
}

# The service version each data source emitted. Worth looking at: `az` sends
# sv=2026-04-06 and the provider need not agree, and the string-to-sign grows
# with the version -- so this is the field that decides which layout is used.
# nonsensitive() because the token itself is a sensitive attribute and the
# version extracted from it inherits that -- and a service version is not a
# secret, it is the field that decides which string-to-sign layout is used.
output "signed_versions" {
  value = {
    container_sas = nonsensitive(regex("sv=([^&]+)", data.azurerm_storage_account_blob_container_sas.read_only.sas)[0])
    account_sas   = nonsensitive(regex("sv=([^&]+)", data.azurerm_storage_account_sas.blob_rw.sas)[0])
  }
}

output "read_only_sas" {
  value     = data.azurerm_storage_account_blob_container_sas.read_only.sas
  sensitive = true
}

output "expired_sas" {
  value     = data.azurerm_storage_account_blob_container_sas.expired.sas
  sensitive = true
}

output "account_sas" {
  value     = data.azurerm_storage_account_sas.blob_rw.sas
  sensitive = true
}

output "queue_only_sas" {
  value     = data.azurerm_storage_account_sas.queue_only.sas
  sensitive = true
}

output "wrong_ip_sas" {
  value     = data.azurerm_storage_account_blob_container_sas.wrong_ip.sas
  sensitive = true
}

# Ready-to-run probes. Each one is a single line, because Terraform's
# local-exec runs under `cmd /C` on Windows where a newline ends the command --
# these are for pasting into a shell, and the same rule keeps them portable.
#
# Note there is no "?" before the token: the provider's `sas` attribute already
# begins with one, where `az storage blob generate-sas` does NOT. Getting it
# wrong appends "??sv=..." and the first parameter is then named "?sv", so the
# token has no version and Nimbus refuses it for missing sv -- an error that
# points at the token rather than at the extra question mark.
output "try_it" {
  value = <<-EOT
    # the CA, so curl trusts the data plane
    CA=$HOME/.nimbus/certs/nimbus-ca.pem
    B=${azurerm_storage_account.data.primary_blob_endpoint}
    RO=$(terraform output -raw read_only_sas)

    # 1. a read-only SAS reads             -> the blob's content
    curl --cacert $CA "$B""private/secret.txt$RO"

    # 2. the same SAS writing               -> 403 AuthorizationPermissionMismatch, naming w (write)
    curl --cacert $CA -X PUT -H 'x-ms-blob-type: BlockBlob' -d nope "$B""private/new.txt$RO"

    # 3. one character of the signature changed -> 403 AuthenticationFailed, quoting the string-to-sign
    curl --cacert $CA "$B""private/secret.txt$(terraform output -raw read_only_sas | sed 's/.$/X/')"

    # 4. an expired SAS                     -> 403, saying when it expired
    curl --cacert $CA "$B""private/secret.txt$(terraform output -raw expired_sas)"

    # 5. an account SAS for queues, on a blob -> 403 AuthorizationServiceMismatch
    curl --cacert $CA "$B""private/secret.txt$(terraform output -raw queue_only_sas)"

    # 6. anonymous on the PUBLIC container  -> the content
    curl --cacert $CA "$B""public/notice.txt"

    # 7. anonymous on the PRIVATE container -> 404, naming nothing
    curl --cacert $CA "$B""private/secret.txt"

    # 8. anonymous LISTING a blob-level public container -> 403: that needs level "container"
    curl --cacert $CA "$B""public?restype=container&comp=list"

    # 9. a SAS bound to somebody else's IP -> 403, naming the address you came from
    curl --cacert $CA "$B""private/secret.txt$(terraform output -raw wrong_ip_sas)"
  EOT
}
